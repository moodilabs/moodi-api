### ===========================================
### Route API 테스트
### ===========================================
### 사용법:
### 1. 서버 실행: ./gradlew bootRun
### 2. 우측 상단 드롭다운에서 "local" 환경 선택
### 3. 아래 "토큰 발급" 먼저 실행 → 자동으로 token 세팅됨
### 4. 이후 원하는 API 옆 ▶ 버튼 클릭
### ===========================================


## -----------------------------------------------
## 1. 개발용 토큰 발급 (local 프로필 전용)
## -----------------------------------------------
### memberId 없이 호출하면 랜덤 UUID로 발급
### DB에 있는 실제 memberId를 넣으면 해당 회원으로 인증됨
GET {{host}}/api/dev/token

> {%
    client.test("토큰 발급 성공", function() {
        client.assert(response.status === 200, "토큰 발급 실패");
        client.global.set("token", response.body.data.accessToken);
        client.log("memberId: " + response.body.data.memberId);
        client.log("token 자동 세팅 완료!");
    });
%}

### memberId 지정해서 발급 (DB에 있는 회원으로 테스트할 때)
# GET {{host}}/api/dev/token?memberId=여기에_UUID

### 소셜 로그인으로 발급 (실제 idToken이 있을 때)
# POST {{host}}/api/v1/auth/login
# Content-Type: application/json
#
# {
#   "provider": "GOOGLE",
#   "idToken": "여기에_구글_idToken_붙여넣기"
# }


## -----------------------------------------------
## 3. Route 초안 생성 (1단계)
## -----------------------------------------------
### spotIds에 실제 DB에 있는 스팟 ID를 넣어주세요
### areas가 있으면 기준 스팟의 무드와 유사한 스팟을 자동으로 채워서 루트 생성
### areas가 빈 배열이면 기준 스팟만으로 루트 생성
### 기간은 1~5일
POST {{host}}/api/routes/generate
Content-Type: application/json
Authorization: Bearer {{token}}

{
  "spotIds": [1, 2],
  "areas": ["Seoul"],
  "startDate": "2026-09-10",
  "endDate": "2026-09-11"
}

> {%
    client.test("초안 생성 성공", function() {
        client.assert(response.status === 200, "초안 생성 실패");
        // 응답 데이터를 저장해서 save 할 때 참고
        client.global.set("generatedRoute", JSON.stringify(response.body.data));
        client.log("초안 생성 완료! days: " + response.body.data.days.length);
    });
%}


## -----------------------------------------------
## 4. Route 저장 (2단계)
## -----------------------------------------------
### 3번 응답을 보고 title, days를 구성
### spotIds는 generate 응답에서 나온 spotId들을 그대로 사용
POST {{host}}/api/routes
Content-Type: application/json
Authorization: Bearer {{token}}

{
  "title": "서울 테스트 여행",
  "startDate": "2026-09-01",
  "endDate": "2026-09-02",
  "days": [
    {
      "dayNumber": 1,
      "date": "2026-09-01",
      "spotIds": [1, 2]
    },
    {
      "dayNumber": 2,
      "date": "2026-09-02",
      "spotIds": [3, 4]
    }
  ]
}

> {%
    client.test("루트 저장 성공", function() {
        client.assert(response.status === 200, "저장 실패");
        client.global.set("routePublicId", response.body.data.publicId);
        client.log("루트 저장 완료! publicId: " + response.body.data.publicId);
    });
%}


## -----------------------------------------------
## 5. Route 상세 조회
## -----------------------------------------------
### 4번에서 저장된 publicId 사용
GET {{host}}/api/routes/{{routePublicId}}
Authorization: Bearer {{token}}


## -----------------------------------------------
## 6. Route 목록 조회
## -----------------------------------------------
GET {{host}}/api/routes?size=20
Authorization: Bearer {{token}}


## -----------------------------------------------
## 7. Route 수정
## -----------------------------------------------
### 스팟 순서 바꾸거나 일정 변경
PUT {{host}}/api/routes/{{routePublicId}}
Content-Type: application/json
Authorization: Bearer {{token}}

{
  "title": "수정된 서울 여행",
  "startDate": "2026-09-01",
  "endDate": "2026-09-02",
  "days": [
    {
      "dayNumber": 1,
      "date": "2026-09-01",
      "spotIds": [2, 1]
    },
    {
      "dayNumber": 2,
      "date": "2026-09-02",
      "spotIds": [3, 4]
    }
  ]
}


## -----------------------------------------------
## 8. 마지막 일차에 스팟 추가
## -----------------------------------------------
POST {{host}}/api/routes/{{routePublicId}}/spots
Content-Type: application/json
Authorization: Bearer {{token}}

{
  "spotId": 5
}


## -----------------------------------------------
## 9. Route 공유
## -----------------------------------------------
POST {{host}}/api/routes/{{routePublicId}}/share
Authorization: Bearer {{token}}


## -----------------------------------------------
## 10. Route 복사
## -----------------------------------------------
POST {{host}}/api/routes/{{routePublicId}}/copy
Authorization: Bearer {{token}}


## -----------------------------------------------
## 11. Route 삭제 (소프트 삭제)
## -----------------------------------------------
DELETE {{host}}/api/routes/{{routePublicId}}
Authorization: Bearer {{token}}
