### ===========================================
### Spot Search API 테스트
### ===========================================
### 사용법:
### 1. 시드 데이터 넣기: cat http/seed-spots.sql | docker compose exec -T postgres psql -U moodi -d moodi
### 2. 서버 실행: ./gradlew bootRun
### 3. 우측 상단 드롭다운에서 "local" 환경 선택
### 4. "토큰 발급" 먼저 실행 → 자동으로 token 세팅됨
### 5. 이후 원하는 API 옆 ▶ 버튼 클릭
### ===========================================


## -----------------------------------------------
## 1. 개발용 토큰 발급 (테스트 회원)
## -----------------------------------------------
### seed-spots.sql에 북마크가 등록된 memberId 사용
GET {{host}}/api/dev/token?memberId=11111111-1111-1111-1111-111111111111

> {%
    client.test("토큰 발급 성공", function() {
        client.assert(response.status === 200, "토큰 발급 실패");
        client.global.set("token", response.body.data.accessToken);
        client.log("memberId: " + response.body.data.memberId);
        client.log("token 자동 세팅 완료!");
    });
%}


## -----------------------------------------------
## 2. 키워드 검색 (기본 - BEST_MATCH)
## -----------------------------------------------
### "강" 으로 검색 → 강남, 강서습지생태공원, 강변스파랜드 등 매칭
GET {{host}}/api/spots/search?keyword=강&size=10
Authorization: Bearer {{token}}

> {%
    client.test("키워드 검색 성공", function() {
        client.assert(response.status === 200, "검색 실패");
        client.log("검색 결과 수: " + response.body.data.items.length);
        response.body.data.items.forEach(function(item) {
            client.log(item.spotId + " | " + item.title + " | 북마크:" + item.bookmarkCount + " | 저장됨:" + item.bookmarked);
        });
        if (response.body.data.nextCursor) {
            client.global.set("bestMatchCursor", response.body.data.nextCursor);
            client.log("다음 커서: " + response.body.data.nextCursor);
        }
    });
%}


## -----------------------------------------------
## 3. 키워드 검색 (MOST_SAVED 정렬)
## -----------------------------------------------
### 북마크 많은 순으로 정렬
GET {{host}}/api/spots/search?keyword=강&sort=MOST_SAVED&size=10
Authorization: Bearer {{token}}

> {%
    client.test("MOST_SAVED 검색 성공", function() {
        client.assert(response.status === 200, "검색 실패");
        client.log("=== 북마크 많은 순 ===");
        response.body.data.items.forEach(function(item) {
            client.log(item.spotId + " | " + item.title + " | 북마크:" + item.bookmarkCount);
        });
    });
%}


## -----------------------------------------------
## 4. 지역(area) 필터
## -----------------------------------------------
### 서울 지역만 필터 (시드 데이터 전부 서울이므로 전체 나옴)
GET {{host}}/api/spots/search?keyword=공원&area=서울&size=10
Authorization: Bearer {{token}}

> {%
    client.test("지역 필터 검색 성공", function() {
        client.assert(response.status === 200, "검색 실패");
        client.log("=== 서울 + '공원' 검색 ===");
        response.body.data.items.forEach(function(item) {
            client.log(item.spotId + " | " + item.title + " | " + item.area + " " + item.district);
        });
    });
%}


## -----------------------------------------------
## 5. 무드 태그 필터
## -----------------------------------------------
### calm 무드 태그로 필터 (소문자 key 사용)
GET {{host}}/api/spots/search?moodTags=calm&sort=MOST_SAVED&size=10
Authorization: Bearer {{token}}

> {%
    client.test("무드 태그 필터 검색 성공", function() {
        client.assert(response.status === 200, "검색 실패");
        client.log("=== CALM 무드 스팟 ===");
        response.body.data.items.forEach(function(item) {
            client.log(item.spotId + " | " + item.title + " | 무드:" + JSON.stringify(item.moodTags));
        });
    });
%}

### 복수 무드 태그 (NATURE + ACTIVE)
GET {{host}}/api/spots/search?moodTags=nature&moodTags=lively&sort=MOST_SAVED&size=10
Authorization: Bearer {{token}}


## -----------------------------------------------
## 6. 내가 저장한 스팟만 (saved=true)
## -----------------------------------------------
### 로그인한 회원의 북마크 스팟만 검색
GET {{host}}/api/spots/search?saved=true&sort=MOST_SAVED&size=10
Authorization: Bearer {{token}}

> {%
    client.test("저장한 스팟 검색 성공", function() {
        client.assert(response.status === 200, "검색 실패");
        client.log("=== 내가 저장한 스팟 ===");
        response.body.data.items.forEach(function(item) {
            client.log(item.spotId + " | " + item.title + " | bookmarked:" + item.bookmarked);
        });
    });
%}


## -----------------------------------------------
## 7. 키워드 없이 전체 조회 (MOST_SAVED)
## -----------------------------------------------
### 키워드 없으면 전체 스팟을 북마크 순으로
GET {{host}}/api/spots/search?sort=MOST_SAVED&size=5
Authorization: Bearer {{token}}

> {%
    client.test("전체 조회 성공", function() {
        client.assert(response.status === 200, "조회 실패");
        client.log("=== 전체 스팟 (북마크순, 5개) ===");
        response.body.data.items.forEach(function(item) {
            client.log(item.spotId + " | " + item.title + " | 북마크:" + item.bookmarkCount);
        });
        if (response.body.data.nextCursor) {
            client.global.set("mostSavedCursor", response.body.data.nextCursor);
            client.log("다음 페이지 커서: " + response.body.data.nextCursor);
        }
    });
%}


## -----------------------------------------------
## 8. 커서 기반 페이징 (다음 페이지)
## -----------------------------------------------
### 7번 실행 후 자동 세팅된 커서로 다음 페이지 조회
GET {{host}}/api/spots/search?sort=MOST_SAVED&size=5&cursor={{mostSavedCursor}}
Authorization: Bearer {{token}}

> {%
    client.test("다음 페이지 조회 성공", function() {
        client.assert(response.status === 200, "페이징 실패");
        client.log("=== 다음 페이지 ===");
        response.body.data.items.forEach(function(item) {
            client.log(item.spotId + " | " + item.title + " | 북마크:" + item.bookmarkCount);
        });
    });
%}


## -----------------------------------------------
## 9. 복합 필터 (키워드 + 지역 + 무드 + 저장됨)
## -----------------------------------------------
GET {{host}}/api/spots/search?keyword=강&area=서울&moodTags=calm&saved=false&sort=BEST_MATCH&size=10
Authorization: Bearer {{token}}


## -----------------------------------------------
## 10. 비로그인 검색 (토큰 없이)
## -----------------------------------------------
### 토큰 없이도 검색 가능 (bookmarked는 항상 false)
GET {{host}}/api/spots/search?keyword=궁&size=10

> {%
    client.test("비로그인 검색 성공", function() {
        client.assert(response.status === 200, "검색 실패");
        client.log("=== 비로그인 검색 ===");
        response.body.data.items.forEach(function(item) {
            client.log(item.spotId + " | " + item.title + " | bookmarked:" + item.bookmarked);
        });
    });
%}


## -----------------------------------------------
## 11. 구(district) 키워드 검색
## -----------------------------------------------
### district도 검색 대상에 포함
GET {{host}}/api/spots/search?keyword=종로구&size=10
Authorization: Bearer {{token}}

> {%
    client.test("구 검색 성공", function() {
        client.assert(response.status === 200, "검색 실패");
        client.log("=== '종로구' 검색 ===");
        response.body.data.items.forEach(function(item) {
            client.log(item.spotId + " | " + item.title + " | " + item.district);
        });
    });
%}
